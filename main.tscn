[sub_resource type="Shader" id="NetShader"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never, shadows_disabled;
uniform vec4 color : source_color = vec4(1.0);
varying vec3 wp;
varying vec3 wn;
void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = abs(NORMAL);
}
void fragment() {
	vec3 g = abs(fract(wp * vec3(1.33, 1.1, 1.25)) - 0.5);
	vec3 on = step(vec3(0.44), g) * (1.0 - step(0.5, wn));
	if (max(max(on.x, on.y), on.z) < 0.5) discard;
	ALBEDO = color.rgb;
	ALPHA = color.a;
}"

